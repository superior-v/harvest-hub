{
  "module": "HarvestHub Module 4 - Proximity Matching & Priority Dispatch",
  "data_note": "Trained on simulated scenarios; not field-validated.",
  "model_file": "harvest_hub_dispatch_model.tflite",
  "input_features": [
    "distance_km",
    "eta_mins",
    "portions",
    "safe_hours",
    "category_id",
    "hub_capacity"
  ],
  "input_notes": "Pass raw values as float32 [N,6]; one-hot, scaling and derived features are inside the model. eta_mins = haversine_km / 22 * 60 + 5.",
  "output": [
    "p_success (0-1)",
    "match_score (0-1)"
  ],
  "category_map": {
    "0": "Cooked",
    "1": "Produce",
    "2": "Dairy",
    "3": "Bakery",
    "4": "Packaged"
  },
  "weights": {
    "priority_formula": "p_success * (0.5 + 0.5 * match_score)",
    "match_score_weights": {
      "time_slack": 0.45,
      "capacity_fit": 0.3,
      "proximity": 0.25
    },
    "escalate_if_max_priority_below": 0.35,
    "urgency_tiers_hours": {
      "CRITICAL": "< 2.0",
      "URGENT": "< 3.0",
      "STANDARD": ">= 3"
    }
  },
  "simulation": {
    "city_speed_kmh": 22.0,
    "dispatch_buffer_min": 5.0,
    "handoff_hours": 0.25,
    "scenarios": 10000
  },
  "hubs": [
    {
      "name": "Central Community Kitchen",
      "lat": 12.974,
      "lon": 77.591,
      "capacity": 120,
      "accepts": [
